# Sourced by every interactive shell in the container, straight from the bind
# mount, so an edit here takes effect in the next shell with no rebuild.
# Project aliases and environment go here.
#
# A server must listen on 0.0.0.0 to be reachable through a published port;
# the usual 127.0.0.1 default is invisible from outside the container. Example:
#
# alias site-dev='bundle exec jekyll serve --port 4001 --host 0.0.0.0'
