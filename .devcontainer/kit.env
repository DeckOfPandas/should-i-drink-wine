# What goes into this project's Claude Code image, and how run.sh starts it.
#
# Plain KEY=value lines. run.sh validates every value, passes the toggles to
# `docker build` as build arguments, and rebuilds whenever one changes. Editing
# a comment here costs nothing.

# Names the image, the container and the volumes. Lowercase letters, digits,
# `.`, `_` and `-`. devcontainer.json repeats it, and tests/kit/ fails if the
# two disagree: `python3 .devcontainer/set-project-name.py <name>` sets both.
PROJECT_NAME=should-i-drink-wine

# Node is always installed, because Claude Code is an npm package.
NODE_MAJOR=24

# Ruby, with build headers for native gems and a persistent bundle cache volume.
# On, the image is built FROM ruby:<RUBY_VERSION>-slim-bookworm.
WITH_RUBY=1
RUBY_VERSION=3.3

# Playwright and headless Chromium under /opt/playwright, for both the npm and
# the pip binding. The version must exist on npm AND PyPI: one version means one
# Chromium shared by both.
WITH_PLAYWRIGHT=1
PLAYWRIGHT_VERSION=1.63.0

# pip-installs .devcontainer/requirements.txt into the image.
WITH_PY_REQS=1

# Host:container port pairs to publish, space-separated. A server inside the
# container must listen on 0.0.0.0 to be reachable through one.
PORTS="9001:9001"

# Hosts the --firewall allowlist adds to the built-in set, space-separated.
EXTRA_ALLOWED_DOMAINS=""

# 1 mounts ~/.bashrc, ~/.bash_aliases, ~/.bash_profile and ~/.gitconfig
# read-only, each only if it exists. Read them for stray secrets first.
MOUNT_DOTFILES=1
