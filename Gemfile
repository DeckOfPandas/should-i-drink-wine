source "https://rubygems.org"

# Jekyll alone. No plugins: every page, feed and endpoint is built from the
# data file with Liquid, and anything needing a plugin is out of scope.
gem "jekyll", "~> 4.3"

# `jekyll serve` needs webrick on Ruby 3, where it is no longer bundled.
gem "webrick", "~> 1.8"
